rules_version = '2';

// OPEN ACCESS — anyone who reaches the site can read, edit and delete every
// job and section. There is no sign-in. Tighten this before the URL goes
// anywhere you would not hand the whole register to.
//
// Only the register lives here (text). PDFs are NOT stored in Firestore — they
// live in each job's ShareFile folder, reached through the File System Access API.
service cloud.firestore {
  match /databases/{database}/documents {

    // jobs/{jobId}                       job name, number, ShareFile folder name, spec files
    // jobs/{jobId}/sections/{sectionKey} the log for one spec section (+ PDF references)
    // jobs/{jobId}/specdata/{sectionKey} that section's spec text
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
