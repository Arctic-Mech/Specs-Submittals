rules_version = '2';

// OPEN ACCESS — anyone who reaches the site can read, edit and delete every
// job, section and PDF. There is no sign-in. Tighten this before the URL goes
// anywhere you would not hand the whole register to.
//
// Cloud Storage is not used; it needs a billing account. PDFs live in
// Firestore instead, split across chunk documents.
service cloud.firestore {
  match /databases/{database}/documents {

    // jobs/{jobId}                       job name, number, spec files, roll-up
    // jobs/{jobId}/sections/{sectionKey} the log for one spec section
    // jobs/{jobId}/specdata/{sectionKey} that section's spec text
    // files/{fileId}                     an uploaded PDF's name, size, chunk count
    // files/{fileId}/chunks/{n}          ~600 KB of that PDF, base64 encoded
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
