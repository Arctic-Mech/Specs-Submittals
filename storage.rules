rules_version = '2';

// OPEN ACCESS — matches firestore.rules. Anyone who reaches the site can read,
// upload and delete any PDF. Tighten this before the URL goes anywhere you
// would not hand the whole document set to.
service firebase.storage {
  match /b/{bucket}/o {

    // jobs/{jobId}/specs/{specId}              the spec PDFs
    // jobs/{jobId}/sections/{sectionKey}/{doc} submittals and responses
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
